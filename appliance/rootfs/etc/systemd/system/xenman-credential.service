# Managed by XenMan: replaced by appliance updates.
#
# The key for XenMan's stored passwords, decrypted into memory for it; see
# /usr/local/sbin/xenman-credential. Pulled in by xenman.service.

[Unit]
Description=Key for XenMan's stored passwords
Before=xenman.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/xenman-credential

[Install]
WantedBy=xenman.service
