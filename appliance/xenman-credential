#!/bin/bash
#
# The key XenMan encrypts the stored XenServer and mail passwords with
# (src/lib/secret-box.ts), kept apart from XenMan's data directory:
#
#   /etc/xenman/secret-key.cred    32 random bytes, encrypted by systemd-creds
#                                  with this machine's key -- its TPM as well, if
#                                  it has one -- so the file is useless anywhere
#                                  else. Made once, on the first start.
#   /run/xenman-secret/secret-key  the key itself, decrypted at boot into
#                                  memory (tmpfs), readable by root and the
#                                  xenman group only; XenMan reads it at start
#                                  (XENMAN_HOST_KEY_FILE in xenman.service).
#
# A backup or copy of /var/lib/xenman alone therefore cannot be decrypted.
# Runs as root before xenman.service (xenman-credential.service). Never stops
# XenMan from starting: when systemd-creds fails, the reason goes to the
# journal and XenMan falls back to a key in its data directory.

set -u

CRED="${CRED:-/etc/xenman/secret-key.cred}"
OUT_DIR="${OUT_DIR:-/run/xenman-secret}"
CREDS="${SYSTEMD_CREDS:-systemd-creds}"
GROUP="${XENMAN_GROUP:-xenman}"
NAME=xenman-secret-key
OUT="${OUT_DIR}/secret-key"

say() {
  logger -t xenman-credential "$*" 2>/dev/null || true
  echo "$*" >&2
}

mkdir -p "${OUT_DIR}"
chown "root:${GROUP}" "${OUT_DIR}"
chmod 0750 "${OUT_DIR}"
rm -f "${OUT}"

if [ ! -s "${CRED}" ]; then
  mkdir -p "$(dirname "${CRED}")"
  # auto: the TPM and the host key when there is a TPM, the host key otherwise.
  if ! (umask 077 && head -c 32 /dev/urandom | "${CREDS}" encrypt --with-key=auto --name="${NAME}" - "${CRED}.tmp"); then
    say "could not create ${CRED}; XenMan uses a key in its data directory instead"
    rm -f "${CRED}.tmp"
    exit 0
  fi
  chmod 0600 "${CRED}.tmp"
  mv "${CRED}.tmp" "${CRED}"
  say "created the key for the stored passwords (${CRED})"
fi

if (umask 027 && "${CREDS}" decrypt --name="${NAME}" "${CRED}" "${OUT}.tmp"); then
  chown "root:${GROUP}" "${OUT}.tmp"
  chmod 0440 "${OUT}.tmp"
  mv "${OUT}.tmp" "${OUT}"
else
  # Kept: it may decrypt again once the reason is gone (a TPM that was there).
  say "could not decrypt ${CRED}; XenMan uses a key in its data directory instead -- passwords stored with this key have to be entered again until it decrypts"
  rm -f "${OUT}.tmp"
fi
exit 0
